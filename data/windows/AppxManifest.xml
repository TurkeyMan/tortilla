<?xml version="1.0" encoding="utf-8"?>
<!--
  Tortilla's sparse package: an identity for the classic install, with no
  files of its own but its logos. Windows 11 puts a packaged app's Explorer
  verbs on its own menu, and only there: the entry is tortilla-shell.dll's
  IExplorerCommand, run in a COM surrogate, the badges and the classic menu
  staying as tortilla registers them. The installer adds it for the user
  installing, with the install directory as its external location, so the
  paths below are relative to that.

  .github/ci/sparse-package.ps1 fills in @VERSION@ (four numbers) and
  @COMMAND_CLSID@ (CMakeLists.txt's WINDOWS_COMMAND_CLSID), then packs and
  signs it. The publisher is the signing certificate's subject: the test
  certificate's until the real one.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <Identity Name="TortillaGit.Tortilla" Publisher="CN=Tortilla Test" Version="@VERSION@"
            ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>Tortilla</DisplayName>
    <PublisherDisplayName>Manu Evans</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us"/>
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
    <rescap:Capability Name="unvirtualizedResources"/>
  </Capabilities>
  <Applications>
    <Application Id="Tortilla" Executable="bin\tortilla.exe"
                 uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <!-- The classic install has the Start menu's shortcut: none here. -->
      <uap:VisualElements DisplayName="Tortilla" Description="Tortilla" BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" AppListEntry="none"/>
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="Tortilla" Clsid="@COMMAND_CLSID@"/>
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="Tortilla" Clsid="@COMMAND_CLSID@"/>
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="Tortilla" Clsid="@COMMAND_CLSID@"/>
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Tortilla">
              <com:Class Id="@COMMAND_CLSID@" Path="bin\tortilla-shell.dll" ThreadingModel="STA"/>
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
