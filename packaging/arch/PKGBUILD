# Tortilla's Arch package, built from this checkout: one package with
# everything, as the .deb and .rpm are (cmake/packaging.cmake).
#
#   cd packaging/arch && makepkg -s
#   sudo pacman -U tortilla-*.pkg.tar.zst
#
# It carries every backend and file manager extension, and needs none of
# their toolkits or file managers: rapport loads the backend that matches
# the desktop, and each file manager loads its own extension.
#
# Maintainer: Manu Evans <turkeyman@gmail.com>
pkgname=tortilla
pkgver=0.1.0
pkgrel=1
pkgdesc="A fast, native git client, with every user interface and the file managers' context menus"
arch=(x86_64 aarch64)
url='https://github.com/TurkeyMan/tortilla'
license=(GPL-3.0-only MIT)
depends=(libgit2 git git-lfs hicolor-icon-theme gcc-libs glibc)
optdepends=('gtk4: the GTK 4 user interface'
            'qt6-base: the Qt 6 user interface'
            'gtk3: the GTK 3 user interface'
            'curl: HTTP (Gravatar pictures)'
            'gdk-pixbuf2: decoding images (Gravatar pictures)'
            'ifritview: comparing images, side by side or as their difference')
# Tortilla's split packages of 0.1.0-alpha, and its packages before its
# rapport was its own: all in this one now.
replaces=(tortilla-rapport tortilla-rapport-gtk3 tortilla-rapport-gtk4 tortilla-rapport-qt6
          tortilla-core tortilla-gtk3 tortilla-gtk4 tortilla-qt
          tortilla-nautilus tortilla-nemo tortilla-caja tortilla-thunar tortilla-dolphin
          tortilla-pcmanfm librapport librapport-dev librapport-gtk3 librapport-gtk4 librapport-qt6)
conflicts=("${replaces[@]}")
makedepends=(cmake ninja git libgit2 gtk3 gtk4 qt6-base
             libnautilus-extension nemo caja thunar kio wayland-protocols)

_root=$(realpath "$startdir/../..")

# A tagged release is its tag's version (v0.1.0 is 0.1.0; v0.1.0-beta is
# 0.1.0beta, which pacman puts before 0.1.0); anything else is a snapshot
# after CMakeLists.txt's version, as the .deb and .rpm are.
pkgver() {
  cd "$_root"
  local base tag
  base=$(sed -n 's/^project(tortilla VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)
  if tag=$(git describe --tags --exact-match --match 'v[0-9]*' 2>/dev/null); then
    printf '%s' "${tag#v}" | tr -d -
  else
    printf '%s.r%s.g%s' "$base" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

build() {
  cmake -S "$_root" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DRAPPORT_EXAMPLES=OFF \
    -DRAPPORT_REQUIRE_BACKENDS=ON \
    -DRAPPORT_REQUIRE_SHELL_EXTENSIONS=ON \
    -DRAPPORT_BACKEND_WIN32=OFF
  cmake --build build
}

check() {
  # The tests make their own repositories, so git needs an identity.
  export GIT_AUTHOR_NAME=makepkg GIT_AUTHOR_EMAIL=makepkg@tortilla.invalid
  export GIT_COMMITTER_NAME=makepkg GIT_COMMITTER_EMAIL=makepkg@tortilla.invalid
  local t scratch
  for t in tortilla-tests tortilla-rebase-tests; do
    scratch=$(mktemp -d)
    build/bin/$t "$scratch"
    rm -rf "$scratch"
  done
}

# rapport is Tortilla's own copy, in /usr/lib/tortilla, so no other app's
# rapport replaces it; its headers aren't packaged. The file managers load
# their extensions when they start: quit one (nautilus -q, ...) for the menu.
package() {
  local c
  for c in core tortilla tortilla_all gtk3 gtk4 qt6 tortilla-shell-{nautilus,nemo,caja,thunar,dolphin,pcmanfm}; do
    DESTDIR="$pkgdir" cmake --install build --component "$c"
  done
  install -Dm644 "$_root/rapport/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/rapport-LICENSE"
}
